generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ══════════════════════════════════════════════════════════════════════════════
// ENUMS
// ══════════════════════════════════════════════════════════════════════════════

enum Role {
  SUPERADMIN   // system-wide admin
  SCHOOL_ADMIN // admin scoped to one school
  TEACHER      // subject teacher; may also be homeroom teacher (homeClassId set)
  STUDENT
  PARENT
}

// ── Learning object lifecycles ────────────────────────────────────────────────

enum TestStatus {
  PREPARING    // teacher is building the test
  READY        // ready to hand out
  DISTRIBUTED  // given to students
  COLLECTING   // collecting papers
  PROCESSING   // scanning / uploading
  COMPLETE     // all results processed
  ARCHIVED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  ANALYZING
  FEEDBACK_READY
  SHARED_WITH_TEACHER
  ARCHIVED
}

enum ResultStatus {
  PENDING      // result record created, no photos yet
  UPLOADED     // photos attached, waiting for analysis
  ANALYZING    // AI running
  DRAFT        // AI done, teacher hasn't reviewed
  REVIEWED     // teacher has seen it
  EDITED       // teacher modified the AI text
  APPROVED     // teacher approved as-is or after edit
  SHARED       // sent to student
  ARCHIVED
}

enum ExerciseStatus {
  ANALYZING
  FEEDBACK_READY
  SHARED_WITH_TEACHER
  ARCHIVED
}

// ── Infrastructure ────────────────────────────────────────────────────────────

enum ScanBatchStatus {
  PENDING
  PROCESSING
  COMPLETE
  ERROR
}

// ── Test library ──────────────────────────────────────────────────────────────

enum OwnershipVisibility {
  PRIVATE  // only current owner
  SCHOOL   // any teacher in owner's school(s)
  PUBLIC   // any teacher in the system
}

enum AccessLevel {
  VIEW        // browse rubric/answerKey, clone
  COLLABORATE // add curriculum links, comment
  CO_EDIT     // edit title / rubric / answerKey
}

// ── Consent ───────────────────────────────────────────────────────────────────

enum ConsentRequestStatus {
  PENDING
  APPROVED
  DECLINED
  EXPIRED
}

enum ConsentGrantStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

enum ConsentScope {
  ALL_SUBJECTS
  SPECIFIC_SUBJECT
}

enum ConsentDuration {
  INFINITE
  DATED
}

// ── Training pipeline ─────────────────────────────────────────────────────────

enum TrainingWorkType {
  TEST_RESULT
  SUBMISSION
  EXERCISE
}

// ══════════════════════════════════════════════════════════════════════════════
// IDENTITY
// ══════════════════════════════════════════════════════════════════════════════

model User {
  id                   String   @id @default(cuid())
  email                String   @unique
  password             String?
  name                 String
  role                 Role     @default(TEACHER)
  personalCode         String?  @unique // Estonian isikukood
  phoneNumber          String?          // for Mobile-ID
  onboardingCompleted  Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  teacherProfile TeacherProfile?
  studentProfile StudentProfile?
  parentProfile  ParentProfile?
  adminProfile   AdminProfile?
  sessions       Session[]
  auditLogs      AuditLog[]
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// TeacherProfile absorbs the old KlassijuhatajProfile.
// homeClassId is set when this teacher serves as homeroom teacher for a class.
model TeacherProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  isActive Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // homeroom teacher relation: FK lives on SchoolClass.homroomTeacherId
  homeClasses SchoolClass[] @relation("HomroomTeacher")

  schools              TeacherSchool[]
  subjects             TeacherSubject[]
  tests                Test[]            // created by this teacher
  ownedTests           Test[]            @relation("TestOwner")
  assignments          Assignment[]
  scanBatches          ScanBatch[]
  accessGrantsReceived TestAccessGrant[] @relation("GrantReceived")
  accessGrantsGiven    TestAccessGrant[] @relation("GrantGiven")
  consentRequestsMade  ConsentRequest[]
  classAssignments     TeacherClassAssignment[]
}

model StudentProfile {
  id         String  @id @default(cuid())
  userId     String  @unique
  schoolId   String?
  classId    String? // → SchoolClass (replaces free-text class String)
  isEligible Boolean @default(false) // set by homeroom teacher or admin

  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School?      @relation(fields: [schoolId], references: [id])
  class  SchoolClass? @relation("ClassStudents", fields: [classId], references: [id])

  parents               ParentStudentLink[]
  testResults           TestResult[]
  assignmentSubmissions AssignmentSubmission[]
  exercises             Exercise[]
  consentRequests       ConsentRequest[]
  consentGrants         ConsentGrant[]
}

// ParentProfile supports both registered (userId set) and unregistered parents
// (userId null — they consent via email link without creating an account).
model ParentProfile {
  id     String  @id @default(cuid())
  userId String? @unique // null = unregistered
  email  String?
  name   String?

  user     User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  children ParentStudentLink[]

  consentRequests ConsentRequest[]
  consentGrants   ConsentGrant[]
}

model ParentStudentLink {
  parentId  String
  studentId String

  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
}

// AdminProfile: schoolId null = system superadmin; schoolId set = school admin.
model AdminProfile {
  id       String  @id @default(cuid())
  userId   String  @unique
  schoolId String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  school School? @relation(fields: [schoolId], references: [id])
}

// ══════════════════════════════════════════════════════════════════════════════
// SCHOOL STRUCTURE
// ══════════════════════════════════════════════════════════════════════════════

model School {
  id       String  @id @default(cuid())
  name     String
  type     String  // gümnaasium, põhikool, keskkool
  district String?
  city     String?

  teacherSchools  TeacherSchool[]
  studentProfiles StudentProfile[]
  adminProfiles   AdminProfile[]
  academicYears   AcademicYear[]
  classes         SchoolClass[]
  tests           Test[]
  assignments     Assignment[]
}

// One row per school year. isActive = the current running year.
model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String?  // null = system-wide default year
  label     String   // "2025/2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)

  school  School? @relation(fields: [schoolId], references: [id])

  classes          SchoolClass[]
  classAssignments TeacherClassAssignment[]
  tests            Test[]
  assignments      Assignment[]
  consentGrants    ConsentGrant[]
}

// SchoolClass is a first-class entity: a named class in a school year.
// The homeroom teacher (klassijuhataja) is a FK to TeacherProfile.
// Students are FK'd here via StudentProfile.classId.
model SchoolClass {
  id               String  @id @default(cuid())
  schoolId         String
  academicYearId   String
  name             String  // "9.B"
  gradeLevel       Int     // 9
  homroomTeacherId String?

  school          School          @relation(fields: [schoolId], references: [id])
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id])
  homroomTeacher  TeacherProfile? @relation("HomroomTeacher", fields: [homroomTeacherId], references: [id])
  students        StudentProfile[] @relation("ClassStudents")
  tests       Test[]
  assignments Assignment[]

  @@unique([schoolId, academicYearId, name])
}

model TeacherSchool {
  teacherId String
  schoolId  String

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  school  School         @relation(fields: [schoolId], references: [id])

  @@id([teacherId, schoolId])
}

model TeacherSubject {
  teacherId String
  subjectId String

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject Subject        @relation(fields: [subjectId], references: [id])

  @@id([teacherId, subjectId])
}

// Which classes a teacher teaches per subject per year.
// E.g., "Ms. Tamm teaches Füüsika to 9A, 9B, 10A in 2025/2026"
model TeacherClassAssignment {
  id              String  @id @default(cuid())
  teacherId       String
  subjectId       String
  academicYearId  String
  gradeLevel      Int     // 1-12
  parallel        String  // "A", "B", "C" etc.

  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject        @relation(fields: [subjectId], references: [id])
  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, subjectId, academicYearId, gradeLevel, parallel])
}

model Subject {
  id          String @id @default(cuid())
  name        String
  category    String  // loodusained, matemaatika, sotsiaalained, etc.
  gradeLevels String  // display string e.g. "7-9, 10-12"

  teacherSubjects  TeacherSubject[]
  classAssignments TeacherClassAssignment[]
  tests            Test[]
  assignments      Assignment[]
  exercises        Exercise[]
  consentGrants    ConsentGrant[]
}

// ══════════════════════════════════════════════════════════════════════════════
// CONSENT
// Collapsed from three models (ParentConsentRequest + ParentConsent +
// SubjectConsent) into two:
//   ConsentRequest — the invite/workflow/paper trail
//   ConsentGrant   — the operative permission record
// ══════════════════════════════════════════════════════════════════════════════

model ConsentRequest {
  id              String               @id @default(cuid())
  requestedById   String               // teacher who initiated
  studentId       String
  parentProfileId String?              // linked once parent registers
  parentEmail     String
  parentName      String?
  inviteToken     String               @unique
  status          ConsentRequestStatus @default(PENDING)
  sentAt          DateTime             @default(now())
  expiresAt       DateTime
  respondedAt     DateTime?
  declineReason   String?
  ipAddress       String?              // captured at response time
  userAgent       String?

  requestedBy   TeacherProfile @relation(fields: [requestedById], references: [id])
  student       StudentProfile @relation(fields: [studentId], references: [id])
  parentProfile ParentProfile? @relation(fields: [parentProfileId], references: [id])

  grants    ConsentGrant[]
  auditLogs AuditLog[]
}

model ConsentGrant {
  id             String             @id @default(cuid())
  requestId      String
  studentId      String
  parentId       String?
  subjectId      String?            // null = all subjects
  academicYearId String?            // null = not year-scoped
  scope          ConsentScope       @default(SPECIFIC_SUBJECT)
  duration       ConsentDuration    @default(INFINITE)
  status         ConsentGrantStatus @default(ACTIVE)
  startDate      DateTime           @default(now())
  endDate        DateTime?
  revokedAt      DateTime?
  revokedBy      String?            // userId who revoked
  note           String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  request      ConsentRequest @relation(fields: [requestId], references: [id])
  student      StudentProfile @relation(fields: [studentId], references: [id])
  parent       ParentProfile? @relation(fields: [parentId], references: [id])
  subject      Subject?       @relation(fields: [subjectId], references: [id])
  academicYear AcademicYear?  @relation(fields: [academicYearId], references: [id])
}

// ══════════════════════════════════════════════════════════════════════════════
// LEARNING OBJECTS
// Three distinct types with different lifecycles — kept as separate models.
// Shared fields (editedFeedback, reviewedAt) are aligned across all three
// to support the two-pass AI pipeline uniformly.
// ══════════════════════════════════════════════════════════════════════════════

// ─── Test (paper exam, teacher-scanned) ──────────────────────────────────────
//
// teacherId = creator (immutable)
// ownerId   = current IP owner (can be transferred; defaults to creator)
// sourceTestId chains the clone tree — walk up for the original
model Test {
  id              String              @id @default(cuid())
  teacherId       String              // creator — immutable
  ownerId         String?             // current IP owner
  subjectId       String?
  schoolId        String?
  classId         String?             // target class (replaces free-text targetClass)
  academicYearId  String?
  title           String
  topic           String?
  grade           String?             // "9" — kept for display / legacy
  rubric          String?             // grading criteria for AI
  answerKey       String?             // correct answers for AI
  blankTestNotes  String?
  notes           String?
  status          TestStatus          @default(PREPARING)
  visibility      OwnershipVisibility @default(PRIVATE)
  sourceTestId    String?             // null = original; set = cloned from
  versionNumber   Int                 @default(1)
  versionNote     String?
  plannedDate     DateTime?
  distributedDate DateTime?
  collectedDate   DateTime?
  completedDate   DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  deletedAt       DateTime?

  teacher      TeacherProfile  @relation(fields: [teacherId], references: [id])
  owner        TeacherProfile? @relation("TestOwner", fields: [ownerId], references: [id])
  subject      Subject?        @relation(fields: [subjectId], references: [id])
  school       School?         @relation(fields: [schoolId], references: [id])
  class        SchoolClass?    @relation(fields: [classId], references: [id])
  academicYear AcademicYear?   @relation(fields: [academicYearId], references: [id])
  sourceTest   Test?           @relation("TestVersions", fields: [sourceTestId], references: [id])
  derivedTests Test[]          @relation("TestVersions")

  results          TestResult[]
  accessGrants     TestAccessGrant[]
  curriculumLinks  TestCurriculumLink[]
  scanBatches      ScanBatch[]
  scanBatchLinks   ScanBatchTestLink[]
}

model TestResult {
  id             String       @id @default(cuid())
  testId         String
  scanBatchId    String?      // which upload batch produced this result
  studentId      String?      // null until scanned name is matched to a profile
  studentName    String?      // fallback display name until matched
  status         ResultStatus @default(PENDING)
  rawFeedback    String?      // original AI JSON (pass 1)
  editedFeedback String?      // fact-checked / teacher-modified JSON (pass 2+)
  teacherNotes   String?      // private, never shown to student
  teacherComment String?      // brief note for training records
  score          Float?
  maxScore       Float?
  storageMode    String       @default("local_only")
  uploadedAt     DateTime?
  analyzedAt     DateTime?
  reviewedAt     DateTime?
  approvedAt     DateTime?
  sharedAt       DateTime?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  test      Test            @relation(fields: [testId], references: [id])
  scanBatch ScanBatch?      @relation(fields: [scanBatchId], references: [id])
  student   StudentProfile? @relation(fields: [studentId], references: [id])

  photos          WorkPhoto[]
  scanPages       ScanBatchPage[]
  trainingConsent TrainingConsent?
}

// ─── Assignment (teacher-issued homework, student submits digitally) ───────────

model Assignment {
  id             String           @id @default(cuid())
  teacherId      String
  subjectId      String?
  schoolId       String?
  classId        String?          // target class
  academicYearId String?
  title          String
  description    String
  grade          String?
  dueDate        DateTime?
  status         AssignmentStatus @default(DRAFT)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  teacher      TeacherProfile @relation(fields: [teacherId], references: [id])
  subject      Subject?       @relation(fields: [subjectId], references: [id])
  school       School?        @relation(fields: [schoolId], references: [id])
  class        SchoolClass?   @relation(fields: [classId], references: [id])
  academicYear AcademicYear?  @relation(fields: [academicYearId], references: [id])

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id             String           @id @default(cuid())
  assignmentId   String
  studentId      String?
  studentName    String?
  status         SubmissionStatus @default(PENDING)
  rawFeedback    String?          // original AI JSON
  editedFeedback String?          // fact-checked version
  reviewedAt     DateTime?
  studentNote    String?
  teacherNote    String?
  sharedAt       DateTime?
  analyzedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  assignment Assignment      @relation(fields: [assignmentId], references: [id])
  student    StudentProfile? @relation(fields: [studentId], references: [id])

  photos          WorkPhoto[]
  trainingConsent TrainingConsent?
}

// ─── Exercise (student self-initiated, no teacher template) ───────────────────

model Exercise {
  id             String         @id @default(cuid())
  studentId      String?
  studentName    String?
  subjectId      String?
  topic          String
  grade          String?
  rawFeedback    String?        // original AI JSON
  editedFeedback String?        // fact-checked version
  reviewedAt     DateTime?
  studentNote    String?
  teacherNote    String?
  status         ExerciseStatus @default(ANALYZING)
  sharedAt       DateTime?
  analyzedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  student StudentProfile? @relation(fields: [studentId], references: [id])
  subject Subject?        @relation(fields: [subjectId], references: [id])

  photos          WorkPhoto[]
  trainingConsent TrainingConsent?
}

// ══════════════════════════════════════════════════════════════════════════════
// PHOTOS (unified)
// One model for all three learning object types.
// Exactly one of testResultId / submissionId / exerciseId must be set.
// base64Data is nullable — being phased out in favour of storageKey (S3/R2).
// ══════════════════════════════════════════════════════════════════════════════

model WorkPhoto {
  id           String    @id @default(cuid())
  testResultId String?
  submissionId String?
  exerciseId   String?
  base64Data   String?   // legacy: inline base64; null once migrated to object storage
  storageKey   String?   // object storage path (S3/R2/Tigris)
  caption      String?
  storageMode  String    @default("local_only")
  uploadedAt   DateTime  @default(now())
  deletedAt    DateTime?

  testResult TestResult?          @relation(fields: [testResultId], references: [id])
  submission AssignmentSubmission? @relation(fields: [submissionId], references: [id])
  exercise   Exercise?            @relation(fields: [exerciseId], references: [id])
}

// ══════════════════════════════════════════════════════════════════════════════
// SCAN INFRASTRUCTURE
// ScanBatch = one PDF upload event.
// primaryTestId = the test the teacher intended to upload (may be null if
// not yet matched). ScanBatchTestLink records all AI-detected test matches
// (including confidence) as proper FK rows — replaces the old JSON blob.
// ══════════════════════════════════════════════════════════════════════════════

model ScanBatch {
  id            String          @id @default(cuid())
  primaryTestId String?         // upload intent FK; null until matched
  uploadedBy    String
  filename      String?
  pageCount     Int?
  status        ScanBatchStatus @default(PENDING)
  errorMsg      String?
  uploadedAt    DateTime        @default(now())

  primaryTest Test?          @relation(fields: [primaryTestId], references: [id])
  uploader    TeacherProfile @relation(fields: [uploadedBy], references: [id])

  testLinks ScanBatchTestLink[]
  pages     ScanBatchPage[]
  results   TestResult[]
}

// One row per AI-detected (or manually confirmed) test match in a batch.
model ScanBatchTestLink {
  id                  String  @id @default(cuid())
  batchId             String
  testId              String
  confidence          Float?  // AI confidence 0.0–1.0
  pageRange           String? // e.g. "1-12" (pages in source PDF)
  isManuallyConfirmed Boolean @default(false)

  batch ScanBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  test  Test      @relation(fields: [testId], references: [id])

  @@unique([batchId, testId])
}

// Per-page record linking a scanned page to the result it produced.
model ScanBatchPage {
  id         String  @id @default(cuid())
  batchId    String
  resultId   String? // null until a TestResult is assigned
  pageIndex  Int     // 0-based position in source PDF
  storageKey String?

  batch  ScanBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  result TestResult? @relation(fields: [resultId], references: [id])
}

// ══════════════════════════════════════════════════════════════════════════════
// TEST LIBRARY
// ══════════════════════════════════════════════════════════════════════════════

model TestAccessGrant {
  id        String      @id @default(cuid())
  testId    String
  granteeId String      // teacher receiving access
  level     AccessLevel
  grantedBy String      // teacherId of owner who granted
  grantedAt DateTime    @default(now())
  expiresAt DateTime?

  test    Test           @relation(fields: [testId], references: [id], onDelete: Cascade)
  grantee TeacherProfile @relation("GrantReceived", fields: [granteeId], references: [id])
  grantor TeacherProfile @relation("GrantGiven", fields: [grantedBy], references: [id])

  @@unique([testId, granteeId])
}

model TestCurriculumLink {
  id             String @id @default(cuid())
  testId         String
  curriculumCode String // riiklik õppekava code e.g. "F9.2.1"
  topicLabel     String?
  gradeRange     String?
  weightPercent  Float?

  test Test @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@unique([testId, curriculumCode])
}

// Canonical catalogue of national curriculum learning outcomes.
// Populated from references/estonian-physics-curriculum.md (and other subjects).
model CurriculumNode {
  code        String  @id    // "F9.2.1"
  subjectCode String         // "physics", "math", etc.
  gradeRange  String         // "7-9"
  topicLabel  String
  description String?
}

// ══════════════════════════════════════════════════════════════════════════════
// TRAINING PIPELINE
// TrainingConsent covers all three learning object types.
// Exactly one of testResultId / submissionId / exerciseId is set.
// ══════════════════════════════════════════════════════════════════════════════

model TrainingConsent {
  id           String          @id @default(cuid())
  testResultId String?         @unique
  submissionId String?         @unique
  exerciseId   String?         @unique
  consentedBy  String          // userId
  consentType  String          // TEACHER | PARENT | STUDENT
  consentedAt  DateTime        @default(now())
  anonymizedAt DateTime?

  testResult TestResult?          @relation(fields: [testResultId], references: [id])
  submission AssignmentSubmission? @relation(fields: [submissionId], references: [id])
  exercise   Exercise?            @relation(fields: [exerciseId], references: [id])

  anonymizedData AnonymizedTrainingData?
}

model AnonymizedTrainingData {
  id             String   @id @default(cuid())
  consentId      String   @unique
  grade          String?
  subject        String?
  score          Float?
  maxScore       Float?
  feedback       String
  teacherNotes   String?
  teacherComment String?
  createdAt      DateTime @default(now())

  consent TrainingConsent @relation(fields: [consentId], references: [id])
}

// ══════════════════════════════════════════════════════════════════════════════
// SYSTEM
// ══════════════════════════════════════════════════════════════════════════════

model AuditLog {
  id               String    @id @default(cuid())
  userId           String?
  action           String    // CONSENT_REQUESTED, DATA_ACCESSED, LOGIN, etc.
  targetType       String?   // User, Test, ConsentRequest, etc.
  targetId         String?
  details          String?   // JSON
  ipAddress        String?
  userAgent        String?
  timestamp        DateTime  @default(now())
  consentRequestId String?

  user           User?           @relation(fields: [userId], references: [id])
  consentRequest ConsentRequest? @relation(fields: [consentRequestId], references: [id])
}

model InviteToken {
  id        String    @id @default(cuid())
  email     String
  name      String    @default("")
  role      Role
  token     String    @unique
  createdBy String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?
}

model FeatureFlag {
  key         String   @id
  enabled     Boolean  @default(false)
  description String
  updatedAt   DateTime @updatedAt
  updatedBy   String?  // userId who last changed it
}

model CookieConsent {
  id          String   @id @default(cuid())
  userId      String?
  sessionId   String?
  consentedAt DateTime @default(now())
  ipAddress   String?
}

